#!/bin/sh
# Valida localmente antes de enviar para o GitHub: testes, auditoria, dist/ sincronizado, smoke e
# Node 20 e 22. A CI remota só confirma no fim (pull request ou tag).
# Activar: npm run hooks:install   Ignorar uma vez: AGENTFORGE_SKIP_PREPUSH=1 git push
[ "$AGENTFORGE_SKIP_PREPUSH" = "1" ] && exit 0
cd "$(git rev-parse --show-toplevel)" || exit 1
exec npm run ci -- --skip-install
