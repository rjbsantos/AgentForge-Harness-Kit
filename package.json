{
  "name": "agentforge-harness-kit",
  "version": "0.9.2",
  "description": "Project-local, multi-role and multi-CLI AgentForge harness installer",
  "type": "module",
  "bin": {
    "agentforge": "./dist/cli/index.js"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "test": "npm run build && node scripts/test.mjs",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "coverage": "npm run build && node scripts/test.mjs --experimental-test-coverage"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "!dist/tests",
    "!dist/**/*.map",
    "docs",
    "CHANGELOG.md",
    "README.md",
    "README.en.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rjbsantos/AgentForge-Harness-Kit.git"
  },
  "bugs": {
    "url": "https://github.com/rjbsantos/AgentForge-Harness-Kit/issues"
  },
  "homepage": "https://github.com/rjbsantos/AgentForge-Harness-Kit#readme",
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  }
}
